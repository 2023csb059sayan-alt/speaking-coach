{
  "name": "@speaking-coach/server",
  "version": "0.1.0",
  "private": true,
  "description": "API for the speaking coach: auth, providers, quota governor, health.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "health": "tsx src/cli/health.ts"
  },
  "dependencies": {
    "@speaking-coach/shared": "*",
    "argon2": "0.45.1",
    "cookie": "0.7.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jose": "5.10.0",
    "mongoose": "8.24.4",
    "pino": "9.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "pino-pretty": "13.0.0",
    "supertest": "^7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
