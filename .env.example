# ---------------------------------------------------------------------------
# Speaking Coach - example environment
#
# Copy to `.env` (repo root or server/) and fill in what you have. Every value has
# a working default for local development, so the server starts with an empty file
# except for the database connection.
#
# Free tiers only. No value here can buy anything: providers that require a card
# are rejected as production defaults by server/src/env.ts.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
LOG_PRETTY=true

# Public URL of this API. Used in password reset links.
API_BASE_URL=http://localhost:8080
# Comma separated allowlist. Only these origins may send credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Local MongoDB for development; MongoDB Atlas M0 (512 MB) in production.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=speaking_coach

# --- Sessions --------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both are REQUIRED in production and must differ. If they are blank in
# development the server generates throwaway values and warns on every boot.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 'none' is required only when the client and API are on different sites, and is
# refused outside production because it needs HTTPS.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- Email (password resets) ----------------------------------------------
# Resend free: 3,000 emails/month, 100/day, 3 domains.
# https://resend.com/pricing
RESEND_API_KEY=
MAIL_FROM=Speaking Coach <noreply@example.com>
RESET_TOKEN_TTL_MINUTES=30

# --- Providers -------------------------------------------------------------
# Every block below is optional. Whatever is missing is reported honestly on
# /api/health/providers and simply never used.

# Groq: chat, transcription and speech. Free, no card.
# https://console.groq.com/docs/rate-limits
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Cloudflare Workers AI: second line for chat and transcription. Free, no card.
# https://developers.cloudflare.com/workers-ai/platform/pricing/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
WORKERS_LLM_MODEL=@cf/openai/gpt-oss-20b

# Gemini: OPT-IN ONLY. Google publishes no numeric free limits and states that
# free-tier content may be used to improve their products, so we never enable it
# for you. Set the model ids yourself after checking the pricing page.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=
GEMINI_TTS_MODEL=

# OpenRouter free models: 20 requests/minute and 50/day while credits are low.
# Model ids change often, so there is no default.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=

# Azure Speech: has a free tier but the account needs card verification and real
# time streaming STT on F0 allows a single concurrent session, so it is never a
# default. Provided for operators who choose to add it.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TTS_VOICE=en-IN-NeerjaNeural

# Ollama: a model on hardware we control. No external quota at all.
OLLAMA_BASE_URL=
OLLAMA_LLM_MODEL=qwen2.5:3b

# --- Chains (ordered fallbacks) -------------------------------------------
CHAIN_STT=groq-stt,workersai-stt
CHAIN_TTS=groq-tts
CHAIN_LLM=groq-llm,workersai-llm

# --- Probes and budgets ---------------------------------------------------
# Deep probes make one real billed request per provider, so they are off by
# default and driven by PROBE_INTERVAL_MINUTES.
DEEP_PROBE=false
PROBE_INTERVAL_MINUTES=15

FAIR_USE_DAILY_SPEAKING_MINUTES=20
INTERVIEW_RESERVED_MINUTES=10

# --- Bring your own key ---------------------------------------------------
# 32 bytes as 64 hex characters or base64. Required in production when enabled.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENABLED=true
BYOK_ENCRYPTION_KEY=

# --- Limits ---------------------------------------------------------------
RATE_LIMIT_AUTH_PER_15_MIN=10
RATE_LIMIT_API_PER_MIN=240
# Audio is never stored unless a learner turns it on themselves.
AUDIO_STORAGE_ENABLED=false
